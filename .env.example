# Tradebot environment — copy to `.env`, fill in, then `chmod 600 .env`.
# The .env is owned by the dedicated non-root bot user. NEVER commit the real .env.

# --- Master encryption key -------------------------------------------------
# Generate ONCE and paste here. Losing it makes every stored credential
# undecryptable (you'd have to re-insert them). Back it up offline.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRADEBOT_MASTER_KEY=

# --- SQL Server connection -------------------------------------------------
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_SERVER=localhost
# Optional explicit port; leave blank to use the driver/instance default (1433).
DB_PORT=1433
DB_NAME=tradebot

# Auth mode: "sql" (SQL login, recommended) or "windows" (Trusted_Connection).
DB_AUTH=sql
DB_USER=tradebot_app
DB_PASSWORD=

# TLS in transit. Encrypt=yes is required by Driver 18 by default.
# Set DB_TRUST_SERVER_CERTIFICATE=yes only if SQL Server uses a self-signed
# cert (e.g. a local dev box). Prefer "no" with a trusted cert in production.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
